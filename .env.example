# Genie V3 API - local environment template. Copy to apps/api/.env for local dev.
# All values below are placeholders only. Never commit a real .env file.

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# PostgreSQL connection (authoritative store for tenants, tasks, audit history)
DATABASE_URL=postgres://genie:CHANGE_ME@localhost:5432/genie_dev
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# Session cookie signing/opaque-token storage. Generate with: openssl rand -hex 32
SESSION_COOKIE_NAME=genie_sid
SESSION_COOKIE_SECRET=CHANGE_ME_64_HEX_CHARS
SESSION_TTL_MINUTES=720

# CSRF double-submit cookie name (non-HttpOnly)
CSRF_COOKIE_NAME=genie_csrf

# Comma-separated absolute origins allowed to make state-changing requests
# (POST/PUT/PATCH/DELETE), including /auth/login. This is the login-CSRF
# defense: a request whose Origin (or Referer origin) is missing or not in this
# list is rejected with 403 before any handler runs. Must be the exact origin of
# the deployed web app, no trailing slash or path.
ALLOWED_ORIGINS=http://localhost:5173

# Reverse proxies allowed to set the client IP via X-Forwarded-For: comma-
# separated IPs or CIDR ranges of the proxy in front of the API (e.g. the
# Coolify/Traefik container network). Leave EMPTY when the API is reached
# directly: then the TCP peer address is the client IP and X-Forwarded-For is
# ignored, so clients cannot choose their own rate-limit bucket. Never "*".
TRUSTED_PROXIES=

# Login throttling (failures only, fixed window). No account-wide lockout.
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_MAX_FAILURES_PER_IP_ACCOUNT=5

# A trusted model-pricing verification older than this is treated as stale and
# the model is refused until re-verified. Seeded registry rows never count.
MODEL_PRICING_MAX_AGE_HOURS=72

# Provider credential encryption-at-rest key. 32-byte key, base64-encoded.
# Generate with: openssl rand -base64 32
# This is the "external deployment secret" referenced in BUILD-SPEC.md - it must
# never be committed, logged, or stored alongside the database it protects.
CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES

# Free-first model policy. Must remain false unless an owner explicitly opts in
# per-tenant via PUT /tenants/{tenantId}/model-policy. This is a hard default,
# not a UI preference.
DEFAULT_ALLOW_PAID_FALLBACK=false

# Hermes adapter. Left unset/disabled until Codex verifies a supported
# programmatic interface on VPS 2. Setting HERMES_ENABLED=true without a real
# adapter implementation must not be done; the stub adapter reports
# "unavailable" honestly instead of faking success.
HERMES_ENABLED=false
HERMES_BASE_URL=
HERMES_API_KEY=

# One-time owner bootstrap (see docs/RUNBOOK.md). Deliberately NOT a .env
# variable: pass BOOTSTRAP_OWNER_EMAIL / BOOTSTRAP_OWNER_PASSWORD /
# BOOTSTRAP_TENANT_NAME inline for the single `npm run bootstrap:owner`
# invocation so they never persist on disk, in fixtures, or in Git. There is no
# default owner password anywhere in this codebase.
