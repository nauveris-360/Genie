# Template for apps/api/.env.test (gitignored). Used by `npm test`, which runs
# the integration suite against a disposable local PostgreSQL database that the
# suite migrates from scratch and truncates between files. Placeholders only.
NODE_ENV=test
PORT=4001
HOST=127.0.0.1
DATABASE_URL=postgres://genie:CHANGE_ME@localhost:5432/genie_test
DATABASE_SSL=false
DATABASE_POOL_MAX=5
SESSION_COOKIE_NAME=genie_sid
SESSION_COOKIE_SECRET=CHANGE_ME_64_HEX_CHARS
SESSION_TTL_MINUTES=60
CSRF_COOKIE_NAME=genie_csrf
ALLOWED_ORIGINS=http://localhost:5173
# Leave unset: the rate-limit tests assert the documented defaults and set
# TRUSTED_PROXIES themselves where needed.
TRUSTED_PROXIES=
CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES
DEFAULT_ALLOW_PAID_FALLBACK=false
HERMES_ENABLED=false
HERMES_BASE_URL=
HERMES_API_KEY=
