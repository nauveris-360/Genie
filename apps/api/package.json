{
  "name": "@genie/api",
  "version": "0.1.0",
  "private": true,
  "description": "Genie V3 backend: Fastify + TypeScript + PostgreSQL. Owns auth, tenant isolation, tasks, approvals, audit history and the free-first model policy.",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && rm -rf dist/migrations && cp -r src/migrations dist/migrations",
    "dev": "node --env-file=.env --import tsx src/index.ts",
    "start": "node --env-file=.env dist/index.js",
    "migrate": "node --env-file=.env --import tsx src/db/cli.ts up",
    "migrate:rollback": "node --env-file=.env --import tsx src/db/cli.ts down",
    "bootstrap:owner": "node --env-file=.env --import tsx src/auth/bootstrapCli.ts",
    "test": "node --env-file=.env.test --import tsx --test --test-concurrency=1 'test/integration/**/*.test.ts'",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@genie/contracts": "0.1.0",
    "fastify": "5.12.5",
    "@fastify/cookie": "11.0.1",
    "argon2": "0.41.1",
    "pg": "8.13.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "@types/pg": "8.11.10",
    "typescript": "5.6.3",
    "tsx": "4.23.15"
  }
}
